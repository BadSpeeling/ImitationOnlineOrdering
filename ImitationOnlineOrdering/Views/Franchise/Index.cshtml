@model IEnumerable<ImitationOnlineOrdering.Models.Franchise>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
@if (Model.Count() > 0)
{
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FranchiseName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>

    @foreach (var item in Model) {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => item.FranchiseName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FranchiseID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FranchiseID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FranchiseID">Delete</a>
            </td>
        </tr>
    }

    </tbody>
</table>
}
else {
    <p>You don't own any Franchises, create one above</p>
}
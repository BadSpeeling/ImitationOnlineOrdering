@model ImitationOnlineOrdering.Models.Franchise

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Franchise</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FranchiseName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FranchiseName)
        </dd>
    </dl>

    <dl class="row">
        <a asp-controller="Restaurant" asp-action="Create" asp-route-franchiseID="@Model.FranchiseID">Create new Restaurant</a>
    </dl>

    @if (Model.Restaurants == null || Model.Restaurants.Count == 0) {
        <div>This franchise currently has no restaurants!</div>
    }
    else {

        <h3>Restaurants</h3>
        <div>
            <div style="border-bottom: 1px solid gray; font-weight: bold; margin: 2px" class="row">
                <div class="col-2">
                    @Html.DisplayNameFor(model => model.Restaurants!.First().StreetAddress)
                </div>
                <div class="col-2">
                    @Html.DisplayNameFor(model => model.Restaurants!.First().City)
                </div>
                <div class="col-1">
                    @Html.DisplayNameFor(model => model.Restaurants!.First().State)
                </div>
                <div class="col-1">
                    @Html.DisplayNameFor(model => model.Restaurants!.First().Zip)
                </div>
                <div class="col-6">

                </div>
            </div>

            @foreach (var restaurant in Model.Restaurants) {
                <div class="row">
                    <div class="col-2">
                        @Html.DisplayFor(model => restaurant.StreetAddress)
                    </div>
                    <div class="col-2">
                        @Html.DisplayFor(model => restaurant.City)
                    </div>
                    <div class="col-1">
                        @Html.DisplayFor(model => restaurant.State)
                    </div>
                    <div class="col-1">
                        @Html.DisplayFor(model => restaurant.Zip)
                    </div>
                    <div class="col-6">
                        <a asp-controller="Restaurant" asp-action="Edit" asp-route-id="@restaurant.RestaurantID">Edit</a> |
                        <a asp-controller="Restaurant" asp-action="Details" asp-route-id="@restaurant.RestaurantID">Details</a> |
                        <a asp-controller="Restaurant" asp-action="Delete" asp-route-id="@restaurant.RestaurantID">Delete</a>
                    </div>
                </div>
            }
        </div>

    }

</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.FranchiseID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
